    "@mikro-orm/decorators": "^7.2.5",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.5",
    "@monitorss/contracts": "^0.3.0",
    "@monitorss/logger": "^1.1.2",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
