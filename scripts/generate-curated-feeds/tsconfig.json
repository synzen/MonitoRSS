{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2017",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "sourceMap": true,
    "declaration": false,
    "noImplicitAny": false
  },
  "include": [
    "index.ts",
    "discover.ts",
    "backfill-search-terms.ts",
    "prod-fetch.ts",
    "prod-fetch.test.ts",
    "prod-fetch-tunnel.ts"
  ]
}
