{
  "name": "backend-api",
  "main": "dist/main.js",
  "private": true,
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "@fastify/compress": "^9.2.1",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/secure-session": "^8.4.1",
    "@fastify/static": "^10.1.6",
    "@monitorss/contracts": "^0.3.0",
    "@monitorss/logger": "^1.1.2",
    "@sinclair/typebox": "^0.34.52",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "handlebars": "^4.7.10",
    "mongoose": "^9.11.1",
    "nodemailer": "^10.1.0",
    "qs": "^6.16.0",
    "rabbitmq-client": "^5.0.8",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "start": "node ./dist/main.js",
    "start:schedule-emitter": "node ./dist/scripts/schedule-emitter.js",
    "dev": "tsx src/main.ts",
    "dev:schedule-emitter": "tsx watch src/scripts/schedule-emitter.ts",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:docker": "bash test-e2e.sh",
    "enforce-limits": "tsx src/scripts/enforce-limits.ts",
    "migrate-legacy-feeds": "tsx src/scripts/migrate-all-legacy-feeds.ts",
    "migrate-legacy-feeds:by-id": "tsx src/scripts/migrate-legacy-feeds-by-id.ts",
    "recalculate-slots": "tsx src/scripts/recalculate-slot-offsets.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qs": "^6.15.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
