{
  "name": "monitorss",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/backend-api",
    "services/bot-presence",
    "services/discord-rest-listener",
    "services/feed-requests",
    "services/user-feeds-next",
    "e2e"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace=packages/contracts --workspace=packages/logger",
    "dev": "npm run dev --workspace=e2e",
    "e2e": "tsx e2e/scripts/run-e2e.ts",
    "e2e:doctor": "tsx e2e/scripts/run-e2e.ts --doctor",
    "e2e:paddle": "tsx e2e/scripts/run-e2e.ts --project=e2e-paddle",
    "e2e:web": "tsx e2e/scripts/run-e2e.ts --project=e2e-web"
  }
}
