    "@nestjs/microservices": "^12.1.2",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-fastify": "^12.1.2",
    "@splitsoftware/splitio": "^11.12.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dayjs": "^1.11.23",
    "zod": "^4.6.5",
    "iconv-lite": "^0.7.3",
    "mongoose": "^9.11.1",
    "pg": "^8.23.1",
    "qs": "^6.16.0",
