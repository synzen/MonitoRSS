{
  "name": "monitorss-feed-requests-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node ./dist/main.js",
    "start:watch": "tsx watch src/main.ts",
    "start:debug": "tsx watch --inspect=0.0.0.0:9229 src/main.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "bash test.sh",
    "migration:up": "tsx src/scripts/run-migrations.ts up",
    "migration:down": "tsx src/scripts/run-migrations.ts down",
    "migration:blank": "tsx src/scripts/blank-migration.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@fastify/compress": "^9.2.1",
    "@monitorss/contracts": "^0.3.0",
    "@monitorss/logger": "^1.1.2",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "iconv-lite": "^0.7.3",
    "pg": "^8.23.1",
    "qs": "^6.16.0",
    "rabbitmq-client": "^5.0.8",
    "redis": "^6.3.0",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qs": "^6.9.20",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  }
}
